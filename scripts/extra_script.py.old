Import("env")
import os
import subprocess
from pathlib import Path

# --- CONFIGURACIÓN CLAVE ---
# Nombre del archivo de salida que Wokwi utilizará
OUTPUT_BIN_NAME = "firmware_combined_for_wokwi.bin"

# Mapa de archivos binarios y sus direcciones de flasheo (offsets) estándar para ESP32
FLASH_MAP = [
    {"offset": "0x1000", "file": "bootloader.bin"},
    {"offset": "0x8000", "file": "partitions.bin"},
    {"offset": "0x10000", "file": "firmware.bin"},
]
# --------------------------

def merge_firmware(source, target, env):
    """
    Función que ejecuta 'python -m esptool merge_bin' para combinar los archivos.
    Se ejecuta como una acción post-build de PlatformIO.
    """
    print("-" * 60)
    print(f"PlatformIO Post-Build: Fusionando archivos binarios para Wokwi...")
    
    # 1. Obtener rutas y configuraciones necesarias
    build_dir = Path(env['PROJECT_BUILD_DIR']).joinpath(env['PIOENV'])
    output_path = build_dir.joinpath(OUTPUT_BIN_NAME)
    
    # 2. Configuración de esptool (valores fijos para mayor robustez)
    chip = env.get('BOARD_MCU', 'esp32')
    # SOLUCIÓN: Usar un modo de flash fijo para evitar el error '80000000L'
    flash_mode = 'dio'
    flash_size = env.get('BOARD_FLASH_SIZE', '4MB')
    
    # 3. Construir los argumentos de archivos (offset y ruta)
    file_args = []
    for item in FLASH_MAP:
        file_path = build_dir.joinpath(item['file'])
        if file_path.exists():
            file_args.extend([item['offset'], str(file_path)])
        else:
            print(f"ADVERTENCIA: Archivo esencial '{item['file']}' no encontrado. Omitiendo.")

    if not file_args:
        print("ERROR: No se encontraron archivos binarios para fusionar. Abortando.")
        return
    
    # 4. Construir el comando completo como una LISTA (seguro para subprocess.run)
    python_exe = env.subst('$PYTHONEXE')
    
    cmd = [
        python_exe,
        '-m', 'esptool',
        '--chip', chip,
        'merge_bin',
        '-o', str(output_path),
        '--flash_mode', flash_mode,
        '--flash_size', flash_size
    ]
    # Añadir los offsets y archivos
    cmd.extend(file_args)
    
    # 5. Ejecutar el comando
    print(f"Ejecutando esptool.py merge_bin...")
    print(f"Comando: {' '.join(cmd)}")
    
    try:
        # Ejecutar sin shell=True y con encoding UTF-8 (soluciona el error cp1252)
        result = subprocess.run(
            cmd, 
            check=True, 
            capture_output=True, 
            text=True, 
            encoding='utf-8' 
        )
        print("Salida de esptool.py:\n", result.stdout.strip())
        print(f"¡Éxito! Archivo combinado creado en: {output_path}")
    except subprocess.CalledProcessError as e:
        print(f"ERROR: Falló la ejecución de esptool.py.")
        print("--- Detalles del Error ---")
        print(e.stderr.strip())
        print("--------------------------")
        env.Exit(1) # Detener la construcción si falla

    print("-" * 60)

# REGISTRO EN PLATFORMIO: Ejecutar esta función después de generar el firmware.bin
env.AddPostAction("$BUILD_DIR/${PROGNAME}.bin", merge_firmware)